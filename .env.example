# --- Required ---

# OpenAI API key. Used once at container startup to log the Codex CLI in
# (`codex login --with-api-key`). The server itself never reads it per-request.
OPENAI_API_KEY=

# MongoDB connection string. The server fails loud at boot without it.
MONGODB_URI=mongodb://localhost:27017/chatify

# --- Optional ---

# HTTP port (default 3000)
PORT=3000

# Root directory for tenant document storage (default ./data).
# Each tenant gets DATA_DIR/tenants/<tenantId>/ — codex exec runs there.
DATA_DIR=./data

# Bootstrap keys for the default tenant created on first boot.
# Leave empty to have random keys generated and printed to the log once.
DEFAULT_ADMIN_KEY=
DEFAULT_MEMBER_KEY=

# Upload size limit in megabytes (default 25)
MAX_UPLOAD_MB=25

# Kill a codex exec run after this many milliseconds (default 600000).
# A stuck agent fails the chat request cleanly instead of hanging it.
CODEX_TIMEOUT_MS=600000

# CORS origin for the API (default *)
CORS_ORIGIN=*

# Logging: error | warn | info | debug (default info)
LOG_LEVEL=info

# Google SSO (optional). Create a Web application OAuth client in Google Cloud.
# Public origin only, with no path. Use https://read2listen.com in production.
PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI: <PUBLIC_APP_URL>/api/auth/google/callback
