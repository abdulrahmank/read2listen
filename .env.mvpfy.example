# Safe local defaults for the mvpfy preview. Everything already defaults to
# these values in docker-compose.mvpfy.yml — you only need a .env file if you
# want to change something (e.g. enable real AI answers).

# --- AI backend ---
# true  = built-in demo replies, no OpenAI account needed (default)
# false = real AI via the Codex CLI; requires OPENAI_API_KEY below
MOCK_EXECUTOR=true

# Only needed when MOCK_EXECUTOR=false. Never commit a real key.
OPENAI_API_KEY=

# --- Demo login (local-only values, shown to the product manager) ---
# Paste one of these in the app's Settings page to sign in.
DEFAULT_ADMIN_KEY=cfy_admin_demo_local_only
DEFAULT_MEMBER_KEY=cfy_member_demo_local_only

# --- Misc ---
LOG_LEVEL=info
